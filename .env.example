# 집대리 환경변수 예시. 실제 값은 .env.local 에만 두고 저장소에 올리지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# 서버 전용(초대 메일 발송·관리 작업). 브라우저에 노출 금지.
SUPABASE_SECRET_KEY=
# 배포 주소(리다이렉트·초대 링크). 비우면 요청 호스트를 쓴다.
NEXT_PUBLIC_SITE_URL=
# Microsoft(Entra ID) 로그인 버튼 표시: Supabase 대시보드에서 Azure 공급자를 켠 뒤 1
NEXT_PUBLIC_AUTH_AZURE=0
# 알림 대기열 처리 라우트 보호용 (Vercel Cron 이 Authorization: Bearer 로 보냄)
CRON_SECRET=
# 집대리 소비자 앱 서버(Cloudflare Worker)가 /api/app/v1/* 를 부를 때 쓰는 키. 앱 Worker 비밀값 MANAGEAPP_APP_KEY 와 같게.
# 만들기: openssl rand -base64 32
APP_SERVER_KEY=
# 현금영수증 발행 대행(팝빌). 링크허브 파트너 연동 키. 테스트 서버=1, 실발행=0
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_IS_TEST=1
# Teams 봇(현금영수증 요청 채팅방). Teams 개발자 포털 > 도구 > 봇 관리에서 만든 봇 id·클라이언트 비밀, 회사 Entra 테넌트 id
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_BOT_TENANT_ID=
