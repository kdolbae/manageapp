# 집대리 환경변수 예시. 실제 값은 .env.local 에만 두고 저장소에 올리지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# 서버 전용(초대 메일 발송·관리 작업). 브라우저에 노출 금지.
SUPABASE_SECRET_KEY=
# 배포 주소(리다이렉트·초대 링크). 비우면 요청 호스트를 쓴다.
NEXT_PUBLIC_SITE_URL=
# Microsoft(Entra ID) 로그인 버튼 표시: Supabase 대시보드에서 Azure 공급자를 켠 뒤 1
NEXT_PUBLIC_AUTH_AZURE=0
# 알림 대기열 처리 라우트 보호용 (Vercel Cron 이 Authorization: Bearer 로 보냄)
CRON_SECRET=
# 온라인 성과(/sales/online): 사업체별 홈페이지 전환 기록·자동 광고비 연결. 값에는 비밀을 넣지 않고 비밀이 든 변수 "이름"만 적는다.
# 예) [{"tenant":"<사업체 uuid>","events_url":"https://<홈페이지>.supabase.co","events_key_env":"NANOMASTER_SUPABASE_SECRET_KEY","ads_repo":"kdolbae/nanomaster-ads","ads_token_env":"ADS_BOARD_TOKEN"}]
ONLINE_SOURCES=
NANOMASTER_SUPABASE_SECRET_KEY=
ADS_BOARD_TOKEN=
